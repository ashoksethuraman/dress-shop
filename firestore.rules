rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: safely checks the isAdmin custom claim.
    // Using .get() avoids a rules error when the claim is absent from the token
    // (e.g. regular users, guest sessions, emulator accounts without the claim).
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.get('isAdmin', false) == true
            || request.auth.token.get('role', '') == 'admin');
    }

    // ── Products ── anyone can read; only admins can write via Cloud Functions
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders ── guests and logged-in users can create;
    //             only the owner (or admin) can read;
    //             updates only via Cloud Functions (admin SDK bypasses rules)
    match /orders/{orderId} {
      allow create: if true;  // guests need this for the direct-SDK fallback path
      allow read:   if request.auth != null
                    && (resource.data.userId == request.auth.uid
                        || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── User profiles ── each user can read/write only their own doc
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }
  }
}
