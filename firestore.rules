rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: safely checks the isAdmin custom claim.
    // Using .get() avoids a rules error when the claim is absent from the token
    // (e.g. regular users, guest sessions, emulator accounts without the claim).
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.get('isAdmin', false) == true
            || request.auth.token.get('role', '') == 'admin');
    }

    // ── Products ── anyone can read; only admins can write via Cloud Functions
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders ── guests and logged-in users can create;
    //             tracking by order ID is public (anyone with the ID can track);
    //             full read (list) only for the owner or admin;
    //             owner or guest order can be updated for payment status after checkout
    match /orders/{orderId} {
      allow create: if true;

      // Public track: anyone who knows the exact order ID can read it (no auth needed).
      // This mirrors GET /orders/track/:id in the functions route.
      allow read: if true;

      allow update: if isAdmin()
                    || (request.auth != null && resource.data.userId == request.auth.uid)
                    || resource.data.isGuest == true;

      allow delete: if false;
    }

    // ── Payments ── anyone can create a record (frontend records after checkout);
    //               only the owner or admin can read
    match /payments/{paymentId} {
      allow create: if true;
      allow read:   if request.auth != null
                    && (resource.data.userId == request.auth.uid
                        || isAdmin());
      allow update, delete: if false;
    }

    // ── User profiles ── each user can read/write only their own doc
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }
  }
}
