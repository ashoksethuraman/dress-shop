    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Firebase Functions",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "restart": true,
            "timeout": 200000,
            "skipFiles": [
                "<node_internals>/**"
            ],
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/workspace",
            // "program": "${workspaceFolder}\\functions\\src\\products.ts",
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        }
    ]
}