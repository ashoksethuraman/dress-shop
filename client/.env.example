# Copy this file to .env.local and fill in your Firebase project values.
# NEVER commit .env.local to source control.

REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Optional: override the Cloud Functions base URL (defaults to asia-south1 region)
# The URL must include the /api path suffix (single Express app function)
# REACT_APP_FUNCTIONS_BASE_URL=https://asia-south1-your_project_id.cloudfunctions.net/api

# Razorpay publishable key (safe to expose in the browser — it's the KEY ID, not the secret)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
