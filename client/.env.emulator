# Local development — Firebase Emulator Suite
#
# Start the client pointing at all local emulators with:
#   npm run start:emulator
#
# This file is loaded via env-cmd (see package.json "start:emulator" script).
# Do NOT rename this file to .env.local — that would affect regular `npm start` too.

# ── Firebase project config (same as production) ────────────────────────────
REACT_APP_FIREBASE_API_KEY=AIzaSyCm8cairV4AJxO5BInRJiFg_S4EwEgpcyc
REACT_APP_FIREBASE_AUTH_DOMAIN=shopping-app-63a1f.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=shopping-app-63a1f
REACT_APP_FIREBASE_STORAGE_BUCKET=shopping-app-63a1f.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=443606900291
REACT_APP_FIREBASE_APP_ID=1:443606900291:web:c2f62a0df76d6fb2503ef6

# ── Emulator overrides ───────────────────────────────────────────────────────
# Points the React app to the local Functions emulator instead of production
REACT_APP_FUNCTIONS_BASE_URL=http://127.0.0.1:5001/shopping-app-63a1f/asia-south1/api

# Tell firebaseClient.ts to connect Auth SDK to the local emulator
REACT_APP_USE_EMULATOR=true

# Razorpay test key
REACT_APP_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
