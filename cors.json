[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "POST", "PUT", "DELETE"],
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "Content-Length",
      "Range",
      "x-goog-resumable",
      "x-goog-stored-content-encoding",
      "x-goog-stored-content-length",
      "x-goog-hash",
      "x-firebase-storage-version"
    ],
    "maxAgeSeconds": 3600
  }
]
